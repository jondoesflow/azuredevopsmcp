{
  "name": "flightbooking-transport-portal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:clean",
    "dev:clean": "npm run port:clear:dev && vite --port 5173",
    "start:clean": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-clean.ps1",
    "api:external-onboarding": "npm run api:external-onboarding:clean",
    "api:external-onboarding:clean": "npm run port:clear:api && node backend/external-onboarding-api.mjs",
    "port:clear:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/clear-ports.ps1 -Ports 5173",
    "port:clear:api": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/clear-ports.ps1 -Ports 8787",
    "validate:policy": "node scripts/validate-policy.mjs",
    "build": "npm run validate:policy && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:auth": "playwright test tests/e2e/auth.setup.spec.ts --project=setup --headed",
    "test:e2e:auth:hold": "playwright test tests/e2e/auth.setup.spec.ts --project=setup --headed --debug",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.0.2",
    "@azure/msal-react": "^5.0.2",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "govuk-frontend": "^5.14.0",
    "lucide-react": "^0.563.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vite-plugin-static-copy": "^3.2.0"
  }
}
