# Azure DevOps Configuration (Required)
AZURE_DEVOPS_ORG=your-org-name
AZURE_DEVOPS_PAT=your-personal-access-token
AZURE_DEVOPS_URL=https://dev.azure.com/your-org-name

# Server Configuration (Optional - defaults shown)
PORT=80
TRANSPORT_MODE=http

# Transport modes:
#   http  - HTTP server for Copilot Studio and remote connections (default)
#   stdio - Standard I/O for local CLI usage

# API Key Authentication (Required for production)
# Set this to secure the /mcp and /sse endpoints. Clients must send this key via:
#   - apikey: <key>          (Copilot Studio - no hyphens allowed)
#   - Authorization: Bearer <key>
#   - x-api-key: <key>
#   - ?api_key=<key> query parameter
# Leave empty to disable auth (development only)
MCP_API_KEY=

# Debug mode (Optional)
DEBUG=false

# Process Migration (Optional)
# When SOURCE_ADO_ORG_URL is set, the server runs a pre-flight check at startup
# to verify the target org has the Enrichment process. If not, it migrates it
# from the source org automatically.
#
# SOURCE_ADO_ORG_URL=https://dev.azure.com/source-org
# SOURCE_ADO_PROJECT=source-project-name
# SOURCE_ADO_PROCESS_NAME=CustomAgile
# SOURCE_ADO_PAT=source-org-pat-token
#
# Target defaults to AZURE_DEVOPS_URL / AZURE_DEVOPS_PAT if not set:
# TARGET_ADO_ORG_URL=https://dev.azure.com/target-org
# TARGET_ADO_PROJECT=target-project-name
# TARGET_ADO_PAT=target-org-pat-token
