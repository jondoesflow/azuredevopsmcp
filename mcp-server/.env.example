# Azure DevOps Configuration (Required)
AZURE_DEVOPS_ORG=your-org-name
AZURE_DEVOPS_PAT=your-personal-access-token
AZURE_DEVOPS_URL=https://dev.azure.com/your-org-name

# Server Configuration (Optional - defaults shown)
PORT=80
TRANSPORT_MODE=http

# Transport modes:
#   http  - HTTP server for Copilot Studio and remote connections (default)
#   stdio - Standard I/O for local CLI usage

# API Key Authentication (Required for production)
# Set this to secure the /mcp and /sse endpoints. Clients must send this key via:
#   - apikey: <key>          (Copilot Studio - no hyphens allowed)
#   - Authorization: Bearer <key>
#   - x-api-key: <key>
#   - ?api_key=<key> query parameter
# Leave empty to disable auth (development only)
MCP_API_KEY=

# Debug mode (Optional)
DEBUG=false
