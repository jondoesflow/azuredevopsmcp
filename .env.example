# Azure AD / Entra ID app registration
VITE_AAD_CLIENT_ID=
VITE_AAD_TENANT_ID=

# Optional if you're using a custom redirect uri (otherwise defaults to window.location.origin)
VITE_AAD_REDIRECT_URI=

# Dataverse
VITE_DATAVERSE_URL=https://org48ab23b4.crm11.dynamics.com
# Entity set name, typically the pluralized schema name (verify in Web API metadata)
VITE_DATAVERSE_ENTITY_SET=jdf_paxdetails

# Dataverse Choice/OptionSet mapping for jdr_documenttype (label -> numeric value)
# Example: {"Passport":100000000,"National ID":100000001}
VITE_DOCUMENT_TYPE_MAP_JSON=


# Set to true to bypass Dataverse and store requests in localStorage
VITE_USE_MOCK=false
