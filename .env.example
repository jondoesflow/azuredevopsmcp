# Azure AD / Entra ID app registration
VITE_AAD_CLIENT_ID=
VITE_AAD_TENANT_ID=

# Optional external authority for email sign-up/sign-in (Entra External ID / B2C style endpoint)
# Example: https://<tenant-subdomain>.ciamlogin.com/<tenant-id-or-domain>/v2.0
VITE_AAD_EXTERNAL_CLIENT_ID=
VITE_AAD_EXTERNAL_AUTHORITY=

# Optional dedicated authority for signup-first flow (if your tenant has a separate signup endpoint)
VITE_AAD_EXTERNAL_SIGNUP_AUTHORITY=

# Optional comma-separated authority hosts trusted by MSAL (needed with external authorities)
# Example: contoso.ciamlogin.com,contoso.b2clogin.com
VITE_AAD_KNOWN_AUTHORITIES=

# Optional base URL for external onboarding API (leave blank to use same-origin /api in dev via Vite proxy)
# Example: https://api.contoso.com
VITE_EXTERNAL_ONBOARDING_API_BASE_URL=

# Optional if you're using a custom redirect uri (otherwise defaults to window.location.origin)
VITE_AAD_REDIRECT_URI=

# Optional MSAL cache location (sessionStorage recommended for security)
# Allowed: sessionStorage | localStorage
VITE_AAD_CACHE_LOCATION=sessionStorage

# External onboarding API (Path B - backend app-only Dataverse write)
EXTERNAL_ONBOARDING_API_PORT=8787
EXTERNAL_ONBOARDING_ALLOWED_ORIGIN=http://localhost:5173
EXTERNAL_ONBOARDING_DATAVERSE_URL=
EXTERNAL_ONBOARDING_TENANT_ID=
EXTERNAL_ONBOARDING_CLIENT_ID=
EXTERNAL_ONBOARDING_CLIENT_SECRET=
EXTERNAL_ONBOARDING_SOLUTION_PREFIX=cap_

# Dataverse
VITE_DATAVERSE_URL=https://org48ab23b4.crm11.dynamics.com

# Solution prefix for all Dataverse entities and columns (e.g., jdr, jdf)
# This prefix is prepended to entity set names and column names
VITE_DATAVERSE_SOLUTION_PREFIX=cap_

# Entity set names (without prefix - prefix is added automatically)
# These are the pluralized logical names for the Dataverse tables
VITE_DATAVERSE_ENTITY_SET=paxdetailses
VITE_DATAVERSE_ENTITY_SET_GROUP=paxgroups

# Dataverse Choice/OptionSet mapping for document type (label -> numeric value)
# Example: {"Passport":833040000,"Warrant Card":833040001,"ID Card":833040002}
VITE_DOCUMENT_TYPE_MAP_JSON=

# Dataverse Choice/OptionSet mapping for transport request status (label -> numeric value)
# Example: {"Approved": 833040000, "Rejected": 833040001, "In Progress": 833040002, "Cancelled": 833040003, "Submitted": 833040004}
VITE_TRANSPORT_REQUEST_STATUS_JSON=

# Dataverse Choice/OptionSet mapping for authorisation status (label -> numeric value)
# Example: {"Pending Approval":833040000,"Approved":833040001,"Rejected by Booking Office":833040002}
VITE_AUTHORISATION_STATUS_JSON=

# Dataverse Choice/OptionSet mapping for military/civilian (label -> numeric value)
# Example: {"Military":833040000,"Civilian":833040001}
VITE_MILCIV_TYPE_MAP_JSON=

# Dataverse Choice/OptionSet mapping for gender (label -> numeric value)
# Example: {"Male":833040000,"Female":833040001,"Undisclosed":833040002}
VITE_GENDER_MAP_JSON=

# Set to true to bypass Dataverse and store requests in localStorage
VITE_USE_MOCK=false

# Persona Client IDs (for testing/impersonation)
VITE_PERSONA_BOOKING_OFFICER_CLIENT_ID=
VITE_PERSONA_PASSENGER_CLIENT_ID=
VITE_PERSONA_HRPERSONNEL_CLIENT_ID=
VITE_PERSONA_AUTHORISER_CLIENT_ID=

# Security Role IDs
VITE_PERSONA_BOOKING_OFFICER_SECURITY_ROLE_ID=
VITE_PERSONA_PASSENGER_SECURITY_ROLE_ID=
VITE_PERSONA_HRPERSONNEL_SECURITY_ROLE_ID=
VITE_SYSTEM_ADMINISTRATOR_SECURITY_ROLE_ID=
VITE_PERSONA_AUTHORISER_SECURITY_ROLE_ID=

# Dataverse View GUIDs
# Rejected passenger bookings - for Booking Officers, HR Personnel, System Admin
VITE_DATAVERSE_VIEW_GUID_REJECTED_PASSENGER_BOOKINGS=

# My passenger bookings - default view for logged in Passenger on My Requests page
VITE_DATAVERSE_VIEW_GUID_MY_PASSENGER_BOOKINGS=

# Queued solo passengers (Submitted/In Progress) - for Authoriser queue Requests tab
VITE_DATAVERSE_VIEW_GUID_QUEDED_PASSENGER_BOOKINGS=

# Queued grouped passengers (Submitted/In Progress) - for Authoriser queue Groups tab
VITE_DATAVERSE_VIEW_GUID_GROUPED_QUEDED_PASSENGER_BOOKINGS=

# Pending Authorisation passenger requests - for Authorisations page assigned queue
VITE_DATAVERSE_VIEW_GUID_PENDING_AUTH_PASSENGER_BOOKINGS=

# Active Authorisers view - for Booking Officers to manage authorised approvers
VITE_DATAVERSE_VIEW_ACTIVE_AUTHORISERS=
