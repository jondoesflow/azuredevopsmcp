# Azure AD / Entra ID app registration
VITE_AAD_CLIENT_ID=
VITE_AAD_TENANT_ID=

# Optional if you're using a custom redirect uri (otherwise defaults to window.location.origin)
VITE_AAD_REDIRECT_URI=

# Dataverse
VITE_DATAVERSE_URL=https://org48ab23b4.crm11.dynamics.com

# Solution prefix for all Dataverse entities and columns (e.g., jdr, jdf)
# This prefix is prepended to entity set names and column names
VITE_DATAVERSE_SOLUTION_PREFIX=cap_

# Entity set names (without prefix - prefix is added automatically)
# These are the pluralized logical names for the Dataverse tables
VITE_DATAVERSE_ENTITY_SET=paxdetailses
VITE_DATAVERSE_ENTITY_SET_GROUP=paxgroups

# Dataverse Choice/OptionSet mapping for document type (label -> numeric value)
# Example: {"Passport":833040000,"Warrant Card":833040001,"ID Card":833040002}
VITE_DOCUMENT_TYPE_MAP_JSON=

# Dataverse Choice/OptionSet mapping for transport request status (label -> numeric value)
# Example: {"Approved": 833040000, "Rejected": 833040001, "In Progress": 833040002, "Cancelled": 833040003, "Submitted": 833040004}
VITE_TRANSPORT_REQUEST_STATUS_JSON=

# Set to true to bypass Dataverse and store requests in localStorage
VITE_USE_MOCK=false

# Persona Client IDs (for testing/impersonation)
VITE_PERSONA_BOOKING_OFFICER_CLIENT_ID=
VITE_PERSONA_PASSENGER_CLIENT_ID=
VITE_PERSONA_HRPERSONNEL_CLIENT_ID=

# Security Role IDs
VITE_PERSONA_BOOKING_OFFICER_SECURITY_ROLE_ID=
VITE_PERSONA_PASSENGER_SECURITY_ROLE_ID=
VITE_PERSONA_HRPERSONNEL_SECURITY_ROLE_ID=
VITE_SYSTEM_ADMINISTRATOR_SECURITY_ROLE_ID=

# Dataverse View GUIDs
# Rejected passenger bookings - for Booking Officers, HR Personnel, System Admin
VITE_DATAVERSE_VIEW_GUID_REJECTED_PASSENGER_BOOKINGS=

# My passenger bookings - default view for logged in Passenger on My Requests page
VITE_DATAVERSE_VIEW_GUID_MY_PASSENGER_BOOKINGS=

# Queued solo passengers (Submitted/In Progress) - for Booking Officer queue Requests tab
VITE_DATAVERSE_VIEW_GUID_QUEDED_PASSENGER_BOOKINGS=

# Queued grouped passengers (Submitted/In Progress) - for Booking Officer queue Groups tab
VITE_DATAVERSE_VIEW_GUID_GROUPED_QUEDED_PASSENGER_BOOKINGS=
