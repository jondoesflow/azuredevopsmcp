VITE_ENTRA_CLIENT_ID=replace-me-spa-client-id
VITE_ENTRA_TENANT_ID=replace-me-tenant-id

# Scope exposed by your BFF App Registration, e.g. api://<api-app-id>/access_as_user
VITE_BFF_SCOPE=api://replace-me-api-app-id/access_as_user

# BFF base URL (no trailing slash)
VITE_BFF_BASE_URL=http://localhost:8080/api
